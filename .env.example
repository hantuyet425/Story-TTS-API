# Generate a long random secret, for example with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TTS_API_KEY=replace-with-a-long-random-secret
# Optional separate secret; if empty, TTS_API_KEY signs temporary audio links.
AUDIO_URL_SECRET=
# Comma-separated exact website origins, e.g. https://reader.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Persistent data directory on deployment; defaults to ./data locally
TTS_DATA_DIR=./data
MAX_QUEUED_JOBS=50
# Maximum simultaneous segment requests for one AU (hard cap: 100).
# Reduce this to 20, 10, 4, 2 or 1 if Edge TTS returns 403/429.
MAX_PARALLEL_CHUNKS=100
TTS_CHUNK_CHAR_LIMIT=5000
MAX_INPUT_CHARACTERS=5000000
AUDIO_URL_TTL_SECONDS=86400
LOG_LEVEL=INFO
